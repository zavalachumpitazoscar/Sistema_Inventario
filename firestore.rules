rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userData().active == true && userData().role == 'admin'; }
    function activeUser() { return signedIn() && userData().active == true; }

    match /users/{userId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }
    match /{collection}/{document=**} {
      allow read, write: if activeUser();
    }
  }
}
